# ---- Database ----
# Local pgAdmin Postgres (what you're using now). No SSL needed:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/reunion"
# Hosted example (Neon) for when you deploy — note ?sslmode=require:
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/reunion?sslmode=require"

# ---- Organizer (admin) login at /admin ----
ADMIN_PASSWORD="change-me-to-something-strong"
# Random secret that signs the admin + access cookies. Generate one in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
ADMIN_SECRET="paste-a-long-random-string-here"

# ---- Class access code (classmates type this to post / add their info) ----
ACCESS_CODE="RAIDERS87"

# ---- Password reset emails (Resend - https://resend.com, free tier) ----
# Without a key, reset emails just won't send (the rest of the site still works).
RESEND_API_KEY=""
# Sender. The default works in test mode (only emails YOUR own address).
# Once you verify riverview1987.com in Resend, use: "Riverview Reunion <reunion@riverview1987.com>"
RESEND_FROM="Riverview Reunion <onboarding@resend.dev>"
# Base URL used to build reset links in emails.
SITE_URL="https://riverview1987.com"
